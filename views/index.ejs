<%- include('partials/header') %>
<section class="intro">
    <p class="eyebrow">Коллекция алгоритмов</p>
    <h1>Изучайте алгоритмы на практике</h1>
    <p>Динамический список элементов, сформированный сервером из массива в памяти.</p>
</section>

<% if (added) { %>
    <p class="success-message" role="status">Алгоритм добавлен.</p>
<% } %>

<div class="section-heading">
    <h2>Все алгоритмы</h2>
    <span class="counter"><%= items.length %> элементов</span>
</div>

<% if (items.length === 0) { %>
    <p class="empty">Элементы пока не добавлены.</p>
<% } else { %>
    <div class="item-grid">
        <% items.forEach((item) => { %>
            <article class="item-card">
                <span class="tag"><%= item.type %></span>
                <h3><%= item.name %></h3>
                <% if (item.description.length > 180) { %>
                    <details class="description-expander">
                        <summary><%= item.description.slice(0, 180).trimEnd() %><span aria-hidden="true">…</span></summary>
                        <p><%= item.description %></p>
                    </details>
                <% } else { %>
                    <p><%= item.description %></p>
                <% } %>
                <a class="text-link" href="/item/<%= item.id %>?auth=1">Подробнее <span aria-hidden="true">&rarr;</span></a>
            </article>
        <% }) %>
    </div>
<% } %>
<script src="/app.js" defer></script>
<%- include('partials/footer') %>
